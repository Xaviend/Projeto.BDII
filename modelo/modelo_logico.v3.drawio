r=#1F5FAD;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e15"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e16" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#3D6FB6;strokeWidth=1.2;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;fontSize=10;" edge="1" parent="1" source="tb_matricula.id_aluno" target="tb_aluno.id_aluno"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16s" value="(0,N)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F5FAD;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e16"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e16t" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F5FAD;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e16"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e17" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#3D6FB6;strokeWidth=1.2;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;fontSize=10;" edge="1" parent="1" source="tb_matricula.id_turma" target="tb_turma.id_turma"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17s" value="(0,N)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F5FAD;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e17"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e17t" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F5FAD;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e17"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e18" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#3D6FB6;strokeWidth=1.2;startArrow=ERzeroToOne;startFill=0;endArrow=ERmandOne;endFill=0;startSize=10;endSize=10;fontSize=10;" edge="1" parent="1" source="tb_historico.id_matricula" target="tb_matricula.id_matricula"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18s" value="(0,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F5FAD;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e18"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e18t" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F5FAD;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e18"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="titulo" value="&lt;b style=&quot;font-size:22px&quot;&gt;Modelo Lógico — Sistema de Matrícula Acadêmica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Banco de Dados II (CCO072) · IESB 2026/2 · Prof. Rodrigo Gonçalves&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="60" as="geometry"/></mxCell><mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;&lt;font color='#C8102E'&gt;PK&lt;/font&gt;&lt;/u&gt;&lt;/b&gt; chave primária &amp;nbsp;·&amp;nbsp; &lt;font color='#1F5FAD'&gt;FK&lt;/font&gt; chave estrangeira &amp;nbsp;·&amp;nbsp; &lt;font color='#888888'&gt;U&lt;/font&gt; único &amp;nbsp;·&amp;nbsp; &lt;font color='#888888'&gt;gerada&lt;/font&gt; coluna calculada&lt;br&gt;Cardinalidade &lt;b&gt;(mín,máx)&lt;/b&gt; em cada ponta da linha: (1,1) exatamente um · (0,1) zero ou um · (0,N) zero ou muitos&lt;br&gt;Pé de galinha: &lt;b&gt;|&lt;/b&gt; = obrigatório, &lt;b&gt;o&lt;/b&gt; = opcional, &lt;b&gt;&amp;lt;&lt;/b&gt; = muitos · linhas ligam FK → PK" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#CCCCCC;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="26" width="1120" height="86" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;Observações&lt;/b&gt;&lt;br&gt;• Mnemônicos: id_ chave · cd_ código · ds_ descrição · dt_ data · dd_ dia · mm_ mês · aa_ ano · hr_ hora · ic_ indicador · nm_ nome · qt_ valor não monetário · sg_ sigla · pc_ porcentagem · vl_ valor monetário&lt;br&gt;• tp_ = tipo ENUM · dm_nota (NUMERIC(4,2) de 0 a 10) · dm_percentual (NUMERIC(5,2) de 0 a 100)&lt;br&gt;• FKs compostas: tb_aluno.(id_curriculo, id_curso) → tb_curriculo (currículo tem que ser do curso do aluno) · tb_turma_horario.(id_turma, id_periodo_letivo) → tb_turma (semestre do horário = semestre da turma)&lt;br&gt;• tb_turma_horario: EXCLUDE impede choque de sala (mesmo semestre, mesma sala, mesmo dia, horários sobrepostos).&lt;br&gt;• UNIQUE compostos: cidade (nm_cidade, sg_uf) · feriado (dt_feriado, id_campus) · curriculo (id_curso, aa_vigencia) · curriculo_disciplina (id_curriculo, id_disciplina) · pre_requisito (id_disciplina, id_disciplina_requisito) · periodo_letivo (aa_periodo, cd_semestre) · sala (id_campus, cd_sala) · turma (cd_turma, id_disciplina, id_periodo_letivo) · matricula (id_aluno, id_turma)&lt;br&gt;• tb_log_matricula não tem FK de propósito · tb_feriado.id_campus nulo = feriado nacional · id_disciplina_requisito: 2ª FK para tb_disciplina (auto-relacionamento)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#CCCCCC;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1424" width="2060" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>