"a213"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="-26" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="a215" style="endArrow=none;html=1;strokeColor=#374151;strokeWidth=1.3;" edge="1" parent="1" source="v95" target="v212"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r216" value="(0,N)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#C8102E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" connectable="0" parent="a215"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell><mxCell id="v217" value="dia da semana" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#111827;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2085.0" y="1852" width="130" height="36" as="geometry"/></mxCell><mxCell id="a218" style="endArrow=none;html=1;strokeColor=#9CA3AF;strokeWidth=1;" edge="1" parent="1" source="v217" target="v212"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v219" value="hora início" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#111827;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2233.0" y="1872" width="114" height="36" as="geometry"/></mxCell><mxCell id="a220" style="endArrow=none;html=1;strokeColor=#9CA3AF;strokeWidth=1;" edge="1" parent="1" source="v219" target="v212"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v221" value="hora fim" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontColor=#111827;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2362.0" y="1842" width="96" height="36" as="geometry"/></mxCell><mxCell id="a222" style="endArrow=none;html=1;strokeColor=#9CA3AF;strokeWidth=1;" edge="1" parent="1" source="v221" target="v212"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v223" value="&lt;b&gt;Como ler (Aula 04, pergunta 6).&lt;/b&gt; Comece pela entidade, siga o verbo e use o par que está junto dela. Sentido horário: &lt;i&gt;“Um ALUNO matricula-se em no mínimo 1 e no máximo N TURMAS”&lt;/i&gt;. Anti-horário: &lt;i&gt;“Uma TURMA tem matriculados no mínimo 0 e no máximo N ALUNOS”&lt;/i&gt;. As duas frases valem ao mesmo tempo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Onde a mínima é 0, e por quê&lt;/b&gt; (cada caso existe na carga do script 03):&lt;br&gt;• FERIADO (0,1): o feriado nacional não pertence a nenhum campus (6 na carga).&lt;br&gt;• CAMPUS (0,N) feriados e (0,N) cursos: o campus Goiânia Centro ainda não tem curso nem feriado local (1 de 2).&lt;br&gt;• DISCIPLINA exige (0,N) / é exigida (0,N): as 4 do 1º semestre não têm pré-requisito e 7 não são pré-requisito de nenhuma (de 24).&lt;br&gt;• SALA (0,N) horários: o auditório e 3 salas teóricas não têm aula fixa (4 de 12).&lt;br&gt;• TURMA (0,N) alunos: turma sem nenhuma matrícula (512 de 1.536).&lt;br&gt;• MATRÍCULA (0,1) histórico: matrícula trancada (169) ou cancelada (218) não gera histórico (387 de 24.964).&lt;br&gt;Todos os outros pares têm mínima 1: o banco não tem nenhum caso sem par." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1960" width="1500" height="180" as="geometry"/></mxCell><mxCell id="v224" value="&lt;b&gt;Do conceitual para o lógico.&lt;/b&gt; Cada entidade vira uma tabela (tb_). O relacionamento 1:N vira FK no lado N (mínima 1 do filho = FK NOT NULL; FERIADO (0,1) = FK que aceita nulo). Os N:N viram associativas: inclui = tb_curriculo_disciplina, exige = tb_pre_requisito, ocupa = tb_turma_horario, matricula-se em = tb_matricula. gera é 1:1 opcional: FK NOT NULL + UNIQUE em tb_historico. Atributo derivado não é digitado: CH total e média final viram coluna gerada. Total: 12 entidades + 4 associativas + tb_log_matricula = 17 tabelas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=12;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#1F2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1580" y="1960" width="1440" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>