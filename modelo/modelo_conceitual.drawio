        <mxCell id="r216" connectable="0" parent="a215" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#C8102E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" value="(0,N)" vertex="1">
